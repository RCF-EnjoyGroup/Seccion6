# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backend
BACKEND_URL=http://localhost:3000

# LLM (NVIDIA NIM)
NVIDIA_API_KEY=
NVIDIA_LLM_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# STT (Deepgram)
DEEPGRAM_API_KEY=

# TTS (Edge TTS — gratuito, sin API key)
# Voces disponibles: es-CO-GonzaloNeural, es-MX-JorgeNeural, es-PE-AlexNeural, es-ES-AlvaroNeural
EDGE_TTS_VOICE=es-CO-GonzaloNeural
